# Kopiér til .env og tilpas. Bruges af docker-compose.yml og sendes videre til PHP
# som miljøvariablerne DB_HOST, DB_NAME, DB_USER og DB_PASS.
DB_HOST=db
DB_NAME=aarshjul
DB_USER=aarshjul
DB_PASS=aarshjul
DB_ROOT_PASS=root

# Porte på din maskine (ret hvis de allerede er i brug)
WEB_PORT=8080
PMA_PORT=8081
DB_FORWARD_PORT=3306
MAILPIT_PORT=8025

# Adressen, årshjulet ligger på (bruges til links i mails)
APP_URL=http://localhost:8080

# Udgående mail. Uden SMTP_HOST sendes alt til Mailpit (http://localhost:8025).
# Til rigtig afsendelse via Simply.com:
#SMTP_HOST=smtp.simply.com
#SMTP_PORT=587
#SMTP_SECURE=tls
#SMTP_USER=aarshjul@ditdomæne.dk
#SMTP_PASS=
#MAIL_FROM=aarshjul@ditdomæne.dk
#MAIL_FROM_NAME=Årshjul
